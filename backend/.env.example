# Database Configuration
MONGODB_URI=//////

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origins for CORS
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Email Service Configuration
# Choose one of: gmail, sendgrid, custom
EMAIL_SERVICE=gmail

# Gmail Configuration (if using Gmail)
EMAIL_USER=dinuka@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@smarthost.com

# SendGrid Configuration (if using SendGrid)
# Uncomment these lines to use SendGrid instead
# SENDGRID_API_KEY=sg_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@smarthost.com

# Custom SMTP Configuration (if using custom SMTP server)
# Uncomment these lines to use custom SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-username
# SMTP_PASSWORD=your-password
# EMAIL_FROM=noreply@smarthost.com

# Email Notifications Settings
# These can be enabled/disabled per user preference
ENABLE_COMPLAINT_EMAILS=true
ENABLE_TASK_EMAILS=true
ENABLE_ORDER_EMAILS=true
ENABLE_NOTICE_EMAILS=true

# Socket.io Configuration
SOCKET_IO_ENABLE=true

# Logging Configuration
LOG_LEVEL=debug
ERROR_LOG_LEVEL=error

# ===========================================
# EMAIL SERVICE ENHANCEMENTS
# ===========================================

# Email Retry Configuration
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=5000

# Email Rate Limiting
EMAIL_RATE_LIMIT=100
EMAIL_BATCH_SIZE=10

# Email Template Configuration
EMAIL_TEMPLATE_PATH=./src/templates/emails
ENABLE_EMAIL_PREVIEW=false

# ===========================================
# NOTIFICATION PREFERENCES
# ===========================================

# Default Notification Settings
DEFAULT_NOTIFICATIONS_ENABLED=true
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_BATCH_INTERVAL=5000

# Role-Based Notification Defaults
STUDENT_RECEIVE_COMPLAINTS=true
STUDENT_RECEIVE_ORDERS=true
WARDEN_RECEIVE_COMPLAINTS=true
WARDEN_RECEIVE_TASK_ASSIGNMENTS=true
STAFF_RECEIVE_TASKS=true
ADMIN_RECEIVE_SYSTEM_ALERTS=true

# ===========================================
# SOCKET.IO ADVANCED SETTINGS
# ===========================================

SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_MAX_HTTP_BUFFER_SIZE=1000000

# ===========================================
# SECURITY & CORS CONFIGURATION
# ===========================================

CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE

# Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# MONITORING & ERROR TRACKING
# ===========================================

ENABLE_ERROR_TRACKING=true
NOTIFY_ADMIN_ON_EMAIL_FAILURE=true
ADMIN_ALERT_EMAIL=admin@smarthost.com

# Optional: Sentry for error tracking
# SENTRY_DSN=

# ===========================================
# DATABASE CONNECTION OPTIONS
# ===========================================

MONGODB_POOL_SIZE=10
MONGODB_MAX_STALENESS=5000
MONGODB_RETRY_WRITES=true

# ===========================================
# FEATURE FLAGS
# ===========================================

ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_BULK_EMAIL_OPERATIONS=true
ENABLE_NOTIFICATION_SCHEDULING=false

# ===========================================
# TESTING & DEVELOPMENT
# ===========================================

TEST_EMAIL_ADDRESS=test@example.com
ENABLE_DEV_EMAIL_MODE=false
MOCK_EMAIL_SERVICE=false

# ===========================================
# API DOCUMENTATION
# ===========================================

ENABLE_SWAGGER=false
SWAGGER_HOST=localhost:5000
SWAGGER_SCHEMES=http

# ===========================================
# FUTURE: BACKGROUND JOB QUEUE (Redis)
# ===========================================

# REDIS_URL=redis://localhost:6379
# ENABLE_JOB_QUEUE=false
